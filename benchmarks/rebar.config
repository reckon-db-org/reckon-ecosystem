{erl_opts, [
    debug_info,
    warnings_as_errors
]}.

{deps, [
    {reckon_db,            "~> 5.9"},
    {reckon_gater,         "~> 3.10"},
    {evoq,                 "~> 1.23"},
    {reckon_evoq,          "~> 2.7"},
    {jsone,                "~> 1.9"}
]}.

{profiles, [
    {bench, [
        {erl_opts, [debug_info]},
        {extra_src_dirs, ["slices"]},
        {src_dirs, ["src", "slices"]},
        %% The slice modules implement the reckon_bench_slice behaviour from
        %% this package, so the bench profile needs it. It is not on hex, which
        %% is why it is here and not in the top-level deps: the default profile
        %% must resolve, and `rebar3 as bench compile` is expected to fail with
        %% "package not found: reckon_bench_harness" until it is released.
        %% That is not planned: the Supervisor ruled the harness stays
        %% unpublished (macula-codebase-checks#2), so this half of the project
        %% does not build and the gate builds the half that does.
        {deps, [{reckon_bench_harness, "~> 0.1"}]}
    ]}
]}.

{shell, [
    {config, "config/sys.config"},
    {apps, [reckon_db, reckon_gater, evoq, reckon_evoq]}
]}.
